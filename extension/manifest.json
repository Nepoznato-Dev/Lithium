{
  "manifest_version": 3,
  "name": "Lithium Performance Extension",
  "version": "1.0.0",
  "description": "Reports real CPU, RAM, and GPU usage to the Lithium desktop",
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
